# SunSync AI - Frontend Local Environment Variables
# Copy this file to .env.local:
#   cp .env.local.example .env.local
# Or on Windows:
#   copy .env.local.example .env.local

# FastAPI Backend Base URL (omit trailing slash)
# Local development default:
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# For Vercel production deployment, set to your deployed backend URL:
# NEXT_PUBLIC_API_BASE_URL=https://sunsync-backend.vercel.app
