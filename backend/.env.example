# SunSync AI — Backend Environment Configuration
PROJECT_NAME="SunSync AI"
VERSION="1.0.0"

# Supabase Postgres Configuration (Leave blank for in-memory demo repository)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# CORS: Add your production frontend Vercel URL
ALLOWED_ORIGINS=http://localhost:3000,https://sunsync-frontend.vercel.app

# Grid Optimization Parameters
INTERVALS_PER_DAY=96
INTERVAL_MINUTES=15
SOLVER_TIME_LIMIT_SECONDS=8.0
DEFAULT_P_MAX_GRID_KW=25.0
DEFAULT_GRID_EMISSION_FACTOR_KG_PER_KWH=0.8200
