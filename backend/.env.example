# SunSync AI — Backend Environment Configuration
PROJECT_NAME="SunSync AI"
VERSION="1.0.0"

# Supabase Postgres Configuration (Leave blank for in-memory demo repository)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# CORS: Add your production frontend Vercel URL
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.example

# Backend-only HMAC signing key for anonymous bearer sessions (minimum 32 random bytes)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Or with OpenSSL: openssl rand -hex 32
SESSION_SIGNING_SECRET=replace-with-at-least-32-random-bytes
# Anonymous bearer session lifetime (seconds)
SESSION_TOKEN_TTL_SECONDS=604800
SESSION_ISSUANCE_MAX_REQUESTS=10

# Grid Optimization Parameters
INTERVALS_PER_DAY=96
INTERVAL_MINUTES=15
SOLVER_TIME_LIMIT_SECONDS=8.0
DEFAULT_P_MAX_GRID_KW=25.0
DEFAULT_GRID_EMISSION_FACTOR_KG_PER_KWH=0.8200
